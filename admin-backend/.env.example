# Copy this file to .env and fill in your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/demo001
# Random string used to sign admin tokens — MUST differ from backend/.env JWT_SECRET.
ADMIN_JWT_SECRET=please-change-me-to-a-random-string
# Default admin seeded at startup (skipped if the email already exists).
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-please
